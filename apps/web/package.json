{
  "name": "@chron/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:agent-skills": "node --no-warnings --experimental-strip-types --test features/agent/skills/*.test.mjs",
    "test:auth-config": "node --no-warnings --experimental-strip-types --test features/auth/server/*.test.mjs",
    "test:calendar-time": "node --no-warnings --experimental-strip-types --test features/calendar/domain/*.test.mjs",
    "test:calendar-layout": "node --no-warnings --experimental-strip-types --test features/calendar/presentation/*.test.mjs",
    "test:calendar-recovery": "node --no-warnings --experimental-strip-types --test features/calendar/presentation/calendar-create-recovery.test.mjs",
    "test:calendar-api": "node --no-warnings --experimental-strip-types --test features/calendar/server/*.test.mjs",
    "test:calendar-expiry-worker": "node --no-warnings --experimental-strip-types --test features/calendar/server/series-expiry-worker.test.mjs",
    "test:reminder-scheduler": "node --test ../reminder-scheduler/src/*.test.mjs",
    "calendar:expire-series": "node --no-warnings --experimental-strip-types scripts/expire-calendar-series-proposals.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@react-three/fiber": "9.8.2",
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
